# ---------------------------------------------------------------------------
# Meet-Up environment configuration
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Path to the SQLite database file. WAL mode is enabled automatically on startup.
DATABASE_PATH=./data.db

# Hex-encoded 256-bit key used to encrypt stored ICS URLs at rest (AES-GCM).
# REQUIRED. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Public base URL of the deployment (used for shareable links and generated invites).
BASE_URL=http://localhost:3000

# The origin the app is served from, e.g. https://meetings.example.com.
# Required for the Node adapter to build correct absolute URLs and to validate
# the Origin header on form posts (CSRF protection). Set to the scheme + host
# that browsers actually use to reach the app. Set to an https:// origin in
# production so auth cookies are marked Secure.
ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# OIDC authentication (all accounts sign in via a single external OIDC provider,
# e.g. Google, Keycloak, Auth0). REQUIRED.
#
# The redirect URI sent to the IdP defaults to ${BASE_URL}/auth/callback. This
# must be registered on the IdP's client. Production BASE_URL/ORIGIN must be
# https:// because OIDC requires an https redirect URI.
# ---------------------------------------------------------------------------

# Issuer URL of the OIDC provider (used for discovery). E.g.
#   https://accounts.google.com
#   https://auth.example.com/realms/meetup
OIDC_ISSUER=

# OIDC client credentials registered on the provider.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Space-separated OIDC scopes to request. Default: 'openid profile'.
# Quote the value — start.sh's simple .env loader sources the file as shell.
OIDC_SCOPE="openid profile"

# Claim name that holds the user's username. Default: 'preferred_username'.
# Set to 'email' (or another claim) if the provider uses email as the username.
OIDC_USERNAME_CLAIM=preferred_username

# Optional explicit override of the redirect URI. Default: ${BASE_URL}/auth/callback.
# OIDC_REDIRECT_URI=

# LOCAL DEVELOPMENT ONLY. openid-client refuses plain http:// issuers by default
# (production requires https). Set to 'true' to allow an http:// OIDC issuer,
# e.g. a local Keycloak/Auth0 at http://localhost:8080. Never enable in production.
OIDC_ALLOW_INSECURE=false

# ---------------------------------------------------------------------------
# LOCAL TESTING: built-in mock OIDC provider (no external IdP needed).
#
# Run `npm run mock-oidc` in a second terminal, then point the app at it:
#   OIDC_ISSUER=http://localhost:8080
#   OIDC_CLIENT_ID=meetup-test
#   OIDC_CLIENT_SECRET=local-test-secret
#   OIDC_ALLOW_INSECURE=true
#   MOCK_OIDC_USERNAME=tester   # the username every mock sign-in uses
# The provider auto-approves every login and issues a signed ID token, so you can
# sign in instantly without configuring a real Google/Keycloak/Auth0 tenant.
# ---------------------------------------------------------------------------

# How often (in minutes) background jobs poll connected ICS URLs. Default: 30.
ICS_POLL_INTERVAL_MINUTES=30

# How many days an event lives before being expired/removed. Default: 7.
EVENT_TTL_DAYS=7