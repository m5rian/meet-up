# ---------------------------------------------------------------------------
# Find-Time environment configuration
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Path to the SQLite database file. WAL mode is enabled automatically on startup.
DATABASE_PATH=./data.db

# Hex-encoded 256-bit key used to encrypt stored ICS URLs at rest (AES-GCM).
# REQUIRED. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Public base URL of the deployment (used for shareable links and generated invites).
BASE_URL=http://localhost:3000

# How often (in minutes) background jobs poll connected ICS URLs. Default: 30.
ICS_POLL_INTERVAL_MINUTES=30

# How many days an event lives before being expired/removed. Default: 7.
EVENT_TTL_DAYS=7